{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"building-generation-spec.schema.json",
 "title":"Building Generation Spec",
 "description":"Versioned, source-aware input contract for deterministic procedural building generation. Coordinates use WGS84 lon/lat degrees; geometry dimensions use metres.",
 "type":"object","required":["schemaVersion","id","name","footprint"],
 "properties":{
  "schemaVersion":{"const":"1.0.0"},
  "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":80},
  "name":{"type":"string","minLength":1,"maxLength":240},
  "location":{"type":"object","required":["longitude","latitude"],"properties":{"longitude":{"type":"number","minimum":-180,"maximum":180},"latitude":{"type":"number","minimum":-85,"maximum":85},"heightM":{"type":"number","minimum":-1000,"maximum":10000}},"additionalProperties":false},
  "footprint":{"type":"object","required":["type","coordinates"],"properties":{"type":{"const":"Polygon"},"coordinates":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"array","minItems":4,"items":{"type":"array","prefixItems":[{"type":"number","minimum":-180,"maximum":180},{"type":"number","minimum":-85,"maximum":85}],"minItems":2,"maxItems":3}}}},"additionalProperties":false},
  "dimensions":{"type":"object","properties":{"floorCount":{"type":"integer","minimum":1,"maximum":100},"floorHeightM":{"type":"number","minimum":2,"maximum":8},"parapetHeightM":{"type":"number","minimum":0,"maximum":5},"wallThicknessM":{"type":"number","minimum":0.08,"maximum":1}},"additionalProperties":false},
  "architecture":{"type":"object","properties":{"style":{"type":"string","minLength":1,"maxLength":80},"roofType":{"enum":["flat","terrace","pitched"]},"wallColor":{"$ref":"#/$defs/color"},"roofColor":{"$ref":"#/$defs/color"},"glassColor":{"$ref":"#/$defs/color"},"frameColor":{"$ref":"#/$defs/color"},"concreteColor":{"$ref":"#/$defs/color"},"doorColor":{"$ref":"#/$defs/color"},"includeDoor":{"type":"boolean"},"balcony":{"type":"object","properties":{"enabled":{"type":"boolean"},"everyFloors":{"type":"integer","minimum":1,"maximum":20},"widthM":{"type":"number","minimum":0.6,"maximum":6},"depthM":{"type":"number","minimum":0.2,"maximum":3}},"additionalProperties":false},"windows":{"type":"object","properties":{"enabled":{"type":"boolean"},"widthM":{"type":"number","minimum":0.4,"maximum":3},"heightM":{"type":"number","minimum":0.4,"maximum":3}},"additionalProperties":false}},"additionalProperties":false},
  "sources":{"type":"array","maxItems":100,"items":{"type":"object","required":["id","kind"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":80},"kind":{"enum":["text","image","video","video-frame","floor-plan","cad","bim","survey","map","other"]},"title":{"type":"string","maxLength":240},"url":{"type":"string","format":"uri","pattern":"^https://"},"assetId":{"type":"string","maxLength":80},"author":{"type":"string","maxLength":500},"licence":{"type":"string","maxLength":500},"attribution":{"type":"string","maxLength":500},"description":{"type":"string","maxLength":2000},"capturedAt":{"type":"string","maxLength":500},"retrievedAt":{"type":"string","maxLength":500},"providerId":{"type":"string","maxLength":500},"usageStatus":{"type":"string","maxLength":40},"location":{"type":"object","required":["longitude","latitude"],"properties":{"longitude":{"type":"number","minimum":-180,"maximum":180},"latitude":{"type":"number","minimum":-85,"maximum":85},"headingDegrees":{"type":"number","minimum":0,"maximum":360}},"additionalProperties":false}},"additionalProperties":false}},
  "evidence":{"type":"array","maxItems":300,"items":{"type":"object","required":["field","confidence","sourceIds"],"properties":{"field":{"type":"string","minLength":1,"maxLength":120},"value":{},"confidence":{"enum":["verified","derived","estimated","ai-proposed","unknown"]},"sourceIds":{"type":"array","uniqueItems":true,"items":{"type":"string","maxLength":80}},"notes":{"type":"string","maxLength":1000}},"additionalProperties":false}},
  "tags":{"type":"array","maxItems":30,"items":{"type":"string","minLength":1,"maxLength":60}}
 },
 "additionalProperties":false,"$defs":{"color":{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"}}
}