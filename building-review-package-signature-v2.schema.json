{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:3d-geospatial-platform:schema:building-review-package-signature:2.0.0",
  "title": "Trusted-reviewer-bound building review package signature",
  "description": "Domain-separated Ed25519 package-integrity attestation bound to the exact package manifest and an active key in the versioned trusted-reviewer registry. It is not a release approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engine",
    "algorithm",
    "signaturePurpose",
    "manifestFilename",
    "manifestSha256",
    "reviewerId",
    "keyId",
    "registryId",
    "publicKeyFingerprintSha256",
    "registryIssuedAtUtc",
    "registryExpiresAtUtc",
    "keyValidFromUtc",
    "keyValidUntilUtc",
    "signedAt",
    "publicationEligible",
    "note",
    "signatureBase64"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "engine": {
      "const": "building-review-package-signature-v2"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "signaturePurpose": {
      "const": "package-integrity-attestation-not-release-approval"
    },
    "manifestFilename": {
      "const": "package-manifest.json"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "registryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "publicKeyFingerprintSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registryIssuedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "registryExpiresAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "keyValidFromUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "keyValidUntilUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "signedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "publicationEligible": {
      "const": false
    },
    "note": {
      "const": "The active trusted-reviewer registry key signed exact package-manifest bytes and signer context. This attests package integrity only; it is not a human release approval, survey certification or accuracy claim."
    },
    "signatureBase64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
