{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:3d-geospatial-platform:schema:trusted-surveyor-public-key-registry:1.0.0",
  "title": "Trusted surveyor public-key registry",
  "description": "Strict public-key-only registry for held-out survey observation attribution signatures. It does not establish civil identity or qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "registryId", "issuedAtUtc", "expiresAtUtc", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "recordType": { "const": "trusted-surveyor-public-key-registry" },
    "registryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "issuedAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "expiresAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surveyorId", "keyId", "status", "publicKeyPem", "validFromUtc", "validUntilUtc", "revokedAtUtc", "replacesKeyId"],
        "properties": {
          "surveyorId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
          "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
          "status": { "enum": ["active", "revoked"] },
          "publicKeyPem": { "type": "string", "minLength": 64, "maxLength": 16384, "not": { "pattern": "PRIVATE KEY" } },
          "validFromUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
          "validUntilUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
          "revokedAtUtc": {
            "anyOf": [
              { "type": "null" },
              { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
            ]
          },
          "replacesKeyId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" }
        }
      }
    }
  }
}