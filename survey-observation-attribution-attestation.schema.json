{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:3d-geospatial-platform:schema:survey-observation-attribution-attestation:1.0.0",
  "title": "Survey observation attribution attestation",
  "description": "Domain-separated Ed25519 signature binding exact opaque observation bytes to a held-out checkpoint and active trusted-surveyor key. This is not measurement certification, receiver authentication or release approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "engine", "algorithm", "signaturePurpose",
    "observationId", "checkpointId", "buildingId",
    "recordSha256", "recordBytes", "controlPointManifestSha256",
    "surveyorId", "keyId", "registryId", "publicKeyFingerprintSha256",
    "registryIssuedAtUtc", "registryExpiresAtUtc", "keyValidFromUtc",
    "keyValidUntilUtc", "attestedAtUtc", "publicationEligible", "note",
    "signatureBase64"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "engine": { "const": "survey-observation-attribution-attestation-v1" },
    "algorithm": { "const": "Ed25519" },
    "signaturePurpose": { "const": "survey-observation-record-attribution-and-checkpoint-association-only" },
    "observationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "checkpointId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "buildingId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "recordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recordBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "controlPointManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "surveyorId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "registryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "publicKeyFingerprintSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "registryIssuedAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "registryExpiresAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "keyValidFromUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "keyValidUntilUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "attestedAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "publicationEligible": { "const": false },
    "note": { "const": "This signature attributes exact opaque record bytes to a declared checkpoint context using an active registered key. It is not survey certification, measurement accuracy evidence, receiver authentication or release approval." },
    "signatureBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  }
}