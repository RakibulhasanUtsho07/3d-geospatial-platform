{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:3d-geospatial-platform:schema:trust-registry-snapshot-inventory:1.0.0",
  "title": "External trust registry snapshot inventory",
  "description": "Binds exact raw UTF-8 bytes of the separate D3M-16 surveyor, D3M-17 device and D3M-18 enrollment-authority public-key registries. Registry contents are not included.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trustRegistrySnapshotSchemaVersion",
    "trustRegistrySnapshotCount",
    "trustRegistrySnapshotBytes",
    "trustRegistrySnapshotsSha256",
    "trustRegistrySnapshots"
  ],
  "properties": {
    "trustRegistrySnapshotSchemaVersion": { "const": "1.0.0" },
    "trustRegistrySnapshotCount": { "const": 3 },
    "trustRegistrySnapshotBytes": { "type": "integer", "minimum": 3, "maximum": 196608 },
    "trustRegistrySnapshotsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trustRegistrySnapshots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "recordType", "registryId", "schemaVersion", "sha256", "bytes"],
        "properties": {
          "role": { "enum": ["surveyor", "device", "enrollment-authority"] },
          "recordType": {
            "enum": [
              "trusted-surveyor-public-key-registry",
              "trusted-survey-device-public-key-registry",
              "trusted-survey-device-enrollment-authority-public-key-registry"
            ]
          },
          "registryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
          "schemaVersion": { "const": "1.0.0" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
        }
      }
    }
  }
}