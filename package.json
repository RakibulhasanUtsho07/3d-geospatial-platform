{
  "name": "3d-geospatial-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "copy:cesium": "node scripts/copy-cesium-assets.mjs",
    "build:geospatial-tiles": "node scripts/build-overture-spatial-tiles.mjs",
    "test:geospatial-tiles": "node --test tests/overture-spatial-tiles.test.mjs",
    "test:geospatial-api": "node --test tests/overture-viewport-api.test.mjs",
    "test:viewport-budget": "node --test tests/viewport-feature-budget.test.mjs",
    "test:viewport-selection": "node --test tests/viewport-feature-selection.test.mjs",
     "predev": "npm run copy:cesium",
    "prebuild": "npm run copy:cesium"
  },
  "dependencies": {
    "cesium": "^1.146.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
